{
  "name": "drobie",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm lint:functions",
    "typecheck": "turbo run typecheck && pnpm typecheck:functions",
    "test": "turbo run test && pnpm test:functions",
    "format": "prettier --write . && deno fmt supabase/functions",
    "format:check": "prettier --check . && deno fmt --check supabase/functions",
    "lint:functions": "deno lint --config supabase/functions/deno.json supabase/functions",
    "typecheck:functions": "deno check --config supabase/functions/deno.json supabase/functions/*/index.ts supabase/functions/_shared/*.ts",
    "test:functions": "deno test --config supabase/functions/deno.json --allow-env --allow-net --allow-read supabase/functions",
    "test:e2e": "bash scripts/dev/e2e.sh",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db && bash scripts/db/concurrency-test.sh postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    "db:test:nodocker": "bash scripts/db/test-local.sh",
    "db:explain": "bash scripts/db/explain-hot-paths.sh",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "turbo": "^2.5.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.46.0"
  }
}
